{
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "timeout": 15,
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/memory/memory-card-hook.py\" --event turn"
          },
          {
            "type": "command",
            "timeout": 10,
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/routing/triage-router.py\""
          },
          {
            "type": "command",
            "timeout": 10,
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/routing/architect-router.py\""
          },
          {
            "type": "command",
            "timeout": 10,
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/routing/model-router.py\" --hook"
          },
          {
            "type": "command",
            "timeout": 10,
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/routing/cve-prompt-guard.py\""
          },
          {
            "type": "command",
            "timeout": 5,
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/guards/push-approve.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/ops/hook-run.py\" scripts/routing/route-gate.py"
          },
          {
            "type": "command",
            "timeout": 5,
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/ops/hook-run.py\" scripts/guards/push-gate.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "async": false,
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/session/session-start.py\""
          },
          {
            "type": "command",
            "timeout": 8,
            "async": true,
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/memory/ide-boot.py\" --session-start"
          },
          {
            "type": "command",
            "timeout": 5,
            "async": false,
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/routing/model-router.py\" --session-start"
          },
          {
            "type": "command",
            "timeout": 8,
            "async": true,
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/session/run_costs.py\" --session-start"
          },
          {
            "type": "command",
            "timeout": 5,
            "async": false,
            "command": "rm -f \"${CLAUDE_PROJECT_DIR:-.}/.raven/.push-mode\" \"${CLAUDE_PROJECT_DIR:-.}/.raven/.push-approved\" \"${CLAUDE_PROJECT_DIR:-.}/.raven/.push-notice-shown\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "async": true,
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/guards/db-guard.py\""
          },
          {
            "type": "command",
            "async": true,
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/guards/secret-scan.py\" --changed-files-only </dev/null"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "async": false,
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/session/token-meter-write.py\""
          },
          {
            "type": "command",
            "async": true,
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/guards/token-guard.py\""
          },
          {
            "type": "command",
            "async": true,
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/dashboard.py\" --html --current-project --if-stale 15"
          },
          {
            "type": "command",
            "async": true,
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/memory/obsidian-log.py\""
          },
          {
            "type": "command",
            "async": true,
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/memory/knowledge-extract.py\" --quiet"
          },
          {
            "type": "command",
            "async": true,
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/guards/session-gate.py\""
          },
          {
            "type": "command",
            "async": true,
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/code-xray.py\" --delta --session \"$(date +%Y-%m-%d)-$(basename \"${CLAUDE_PROJECT_DIR:-$PWD}\")\"; python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/code-xray.py\" --html"
          },
          {
            "type": "command",
            "timeout": 15,
            "async": true,
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/memory/memory-card-hook.py\" --event exit"
          }
        ]
      }
    ]
  },
  "_generated": "GENERATED from .claude/settings.json by scripts/export-hook-configs.py \u2014 do not hand-edit; run the exporter after changing the canonical file."
}
